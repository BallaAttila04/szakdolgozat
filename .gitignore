# Nyers AIS adat - nagy fajlok (tobb szaz MB/nap), nem valok git-be
data/
*.zip

# Benchmark munkakonyvtar - kicsomagolt CSV/Parquet/.duckdb (10+ GB),
# barmikor ujrageneralhato a ZIP-ekbol
bench_workdir/
*.parquet
*.duckdb
*.log

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Terkep generalt kimenetei - a scripts/terkep_adat.py,
# scripts/hajo_adatok.py es scripts/terkep_epit.py barmikor ujrageneralja
# oket a nyers ZIP-bol
terkep_adat.json
hajo_adatok.json
terkep.html

# KIVETEL: a docs/ a GitHub Pages altal kiszolgalt oldal, ezt verziozni kell,
# kulonben a konzulensnek kuldott link torott terkepre mutat. Az oldal_epit.py
# masolja ide az outputs/-bol.
!docs/terkep.html

# Futtatasi naplok
outputs/logs/

# A dolgozat szovege - NEM valo a publikus repoba
dolgozat/
*.docx

# A pipeline.py Parquet-tarolja es munkakonyvtara (napi tobb szaz MB, ujrageneralhato)
outputs/tarolo/
outputs/tarolo_dr50/
outputs/tarolo_munka/
outputs/skalazas_csv_*/
outputs/geoparquet/

# A kapu_kiterjesztes.py napi koztes fajljai (ujrainditashoz); az osszesitett
# atkelesek.csv es kapuvonal_napi.csv verziozott
outputs/kapuk_kiterjesztes/napok/

# A kiterjesztett Hormuz-minta egyesitett munkamappaja (a 76 + 182 nap masolata)
outputs/hormuz/kiterjesztett/teljes/

# Fagyasztott monitorallapot (git show f8603b3:outputs/monitor/*), ujraeloallithato
outputs/fagyasztas_*/

# A dan idosor kitoltese (hormuz_kitoltes.py): csak a kis osszesito fajlok verziozottak,
# a reszletes atkeles- es merulestablak (~50 MB) ujrageneralhatok
outputs/hormuz/kitoltes/*
!outputs/hormuz/kitoltes/napi.csv
!outputs/hormuz/kitoltes/feldolgozas.csv
!outputs/hormuz/kitoltes/pipeline_napok.csv
!outputs/hormuz/kitoltes/mintanapok.csv
outputs/tarolo_hormuz_kitoltes/
outputs/tarolo_hormuz_tmp/
